##############################################
# BACKEND API (local development)
##############################################
# Browser calls stay same-origin; Next proxies /api to Django.
NEXT_PUBLIC_API_BASE=/api
API_PROXY_BASE=http://127.0.0.1:8000/api
NEXT_PUBLIC_BACKEND_BASE=http://127.0.0.1:8000

##############################################
# UNIVERSE HOST ROUTING (local development)
##############################################
# Keeps Universe switches on <universe>.localhost instead of production.
NEXT_PUBLIC_KONNAXION_UNIVERSE_BASE_DOMAIN=localhost

##############################################
# BUILD / ANALYZE
##############################################
ANALYZE=false

##############################################
# MAPBOX
##############################################
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.__your_mapbox_token__
MAPBOX_ACCESS_TOKEN=pk.__your_mapbox_token__

##############################################
# DEVELOPMENT OPTIONS
##############################################
NODE_ENV=development
