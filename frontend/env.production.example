##############################################
# BACKEND API (production, same origin)
##############################################
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_BACKEND_BASE=https://konnaxion.com

##############################################
# BUILD / ANALYZE
##############################################
ANALYZE=false

##############################################
# MAPBOX (production)
##############################################
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.__your_mapbox_token__
MAPBOX_ACCESS_TOKEN=pk.__your_mapbox_token__

# Public frontend URL
APP_BASE_URL=https://konnaxion.com
NEXT_PUBLIC_APP_BASE_URL=https://konnaxion.com

##############################################
# ENVIRONMENT OPTIONS
##############################################
NODE_ENV=production
